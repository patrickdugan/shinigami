// Generated by scripts/core_vectors/gen_regressions.py. Each test pins a behaviour that
// Bitcoin Core's script test vectors showed to be wrong in this engine.

use shinigami_engine::engine::EngineImpl;
use shinigami_engine::hash_cache::HashCacheImpl;
use shinigami_engine::transaction::{EngineInternalTransactionTrait, UTXO};
use shinigami_utils::bytecode::hex_to_bytecode;

fn verify(
    tx_hex: ByteArray, prevouts: Array<(i64, ByteArray)>, index: u32, flags: u32,
) -> Result<(), felt252> {
    let mut utxos: Array<UTXO> = array![];
    for prevout in prevouts {
        let (amount, script_hex) = prevout;
        utxos
            .append(
                UTXO { amount, pubkey_script: hex_to_bytecode(@script_hex), block_height: 0 },
            );
    };
    let transaction = EngineInternalTransactionTrait::deserialize(
        hex_to_bytecode(@tx_hex), 0, utxos.clone(),
    );
    let prevout = utxos.at(index);
    let hash_cache = HashCacheImpl::new(@transaction);
    let mut engine = EngineImpl::new(
        prevout.pubkey_script, @transaction, index, flags, *prevout.amount, @hash_cache,
    )?;
    engine.execute()?;
    Result::Ok(())
}

// transaction version above 2^31 (random versions in feature_taproot.py)
// script_assets/0/success: siglen/empty_keypath | P2SH,DERSIG,CHECKLOCKTIMEVERIFY,CHECKSEQUENCEVERI
#[test]
fn test_script_assets_0_success() {
    let res = verify(
        "",
        array![
            (31582900, "0x512039f7e9232896f8100485e38afa652044f855e734a13b840a3f220cbd5d911ad5"),
        ],
        0,
        0x1105b,
    );
    res.unwrap();
}

