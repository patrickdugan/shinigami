// a 33-byte DER integer is a failing signature, not an encoding error
// script_tests/1029: 0x49 0x30460221010101010101010101010101010101010101010101010101010101010101010
#[test]
fn test_script_tests_1029() {
    let res = verify(
        "0x0100000001581d6e3b3cf4d2bb59ee9c2c03e6566c5237402e303c595ed696a49a907fd9ab000000004a4930460221010101010101010101010101010101010101010101010101010101010101010101022101010101010101010101010101010101010101010101010101010101010101010101ffffffff0100000000000000000000000000",
        array![
            (0, "0x00ac91"),
        ],
        0,
        0x40,
    );
    res.unwrap();
}

