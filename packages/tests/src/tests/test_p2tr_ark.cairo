// A script-path spend with one bit of the signature flipped.
#[test]
fn test_ark_script_path_wrong_signature() {
    let res = validate_spend(
        "",
        10000,
        "0x51200aabaa2768f0d46559b0f333c3c5eb5cfc716c4e59be2b2fe0dd7da39fd962c5",
    );
    assert_eq!(res.unwrap_err(), Error::SIG_NULLFAIL);
}

// The hash lock is not satisfied by a different preimage.
#[test]
fn test_ark_script_path_wrong_preimage() {
    let res = validate_spend(
        "",
        10000,
        "0x51200aabaa2768f0d46559b0f333c3c5eb5cfc716c4e59be2b2fe0dd7da39fd962c5",
    );
    assert_eq!(res.unwrap_err(), Error::VERIFY_FAILED);
}

