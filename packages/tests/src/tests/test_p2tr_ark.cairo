// Exit transaction chains of Ark VTXOs, taken from the test vectors of bark's ark-lib 0.7.1
// (https://gitlab.com/ark-bitcoin/bark, lib/src/test_util/vectors.rs).
//
// A VTXO is the output of a chain of pre-signed transactions rooted at an on-chain output.
// Board, tree-node and arkoor transactions are Taproot key-path spends. The leaf of a round
// tree is a script-path spend of a hash-lock leaf:
// OP_SIZE 32 OP_EQUALVERIFY OP_HASH160 <hash> OP_EQUALVERIFY <key> OP_CHECKSIG.
// bark checks the same transactions against libbitcoinkernel in its own test suite.

use shinigami_engine::errors::Error;
use shinigami_engine::flags::ScriptFlags;
use shinigami_engine::transaction::{EngineInternalTransactionTrait, UTXO};
use shinigami_utils::bytecode::hex_to_bytecode;
use crate::validate;

// Validates the only input of a transaction against the output it spends.
fn validate_spend(
    raw_transaction_hex: ByteArray, prevout_amount: i64, prevout_script_hex: ByteArray,
) -> Result<(), felt252> {
    let flags: u32 = ScriptFlags::ScriptBip16.into()
        | ScriptFlags::ScriptVerifyWitness.into()
        | ScriptFlags::ScriptVerifyTaproot.into();
    let utxo_hints = array![
        UTXO {
            amount: prevout_amount,
            pubkey_script: hex_to_bytecode(@prevout_script_hex),
            block_height: 0,
        },
    ];
    let prevout = UTXO {
        amount: prevout_amount,
        pubkey_script: hex_to_bytecode(@prevout_script_hex),
        block_height: 0,
    };
    let transaction = EngineInternalTransactionTrait::deserialize(
        hex_to_bytecode(@raw_transaction_hex), 0, utxo_hints,
    );
    validate::validate_transaction_at(@transaction, flags, prevout, 0)
}

// A boarded vtxo: key path.
#[test]
fn test_ark_exit_chain_board() {
    validate_spend(
        "",
        10330,
        "0x5120652675904a84ea02e24b57b3d547203d2ce71526113d35bf4d02e0b4efbe9a2d",
    )
        .unwrap();
}

// An out-of-round payment into an htlc vtxo: key path, key path, key path.
#[test]
fn test_ark_exit_chain_arkoor_htlc_out() {
    validate_spend(
        "",
        10330,
        "0x5120652675904a84ea02e24b57b3d547203d2ce71526113d35bf4d02e0b4efbe9a2d",
    )
        .unwrap();
    validate_spend(
        "",
        10000,
        "0x5120e2b1152658195dae2fb792bdf7adb276e1c21f06b33588b9bd8429591bb964ea",
    )
        .unwrap();
    validate_spend(
        "",
        9000,
        "0x5120652675904a84ea02e24b57b3d547203d2ce71526113d35bf4d02e0b4efbe9a2d",
    )
        .unwrap();
}

