// A key-path spend with one bit of the signature flipped.
#[test]
fn test_ark_key_path_wrong_signature() {
    let res = validate_spend(
        "",
        10330,
        "0x5120652675904a84ea02e24b57b3d547203d2ce71526113d35bf4d02e0b4efbe9a2d",
    );
    assert_eq!(res.unwrap_err(), Error::TAPROOT_INVALID_SIG);
}

// The signature commits to the amount of the output being spent.
#[test]
fn test_ark_key_path_wrong_prevout_amount() {
    let res = validate_spend(
        "",
        10331,
        "0x5120652675904a84ea02e24b57b3d547203d2ce71526113d35bf4d02e0b4efbe9a2d",
    );
    assert_eq!(res.unwrap_err(), Error::TAPROOT_INVALID_SIG);
}

// The signature commits to the transaction's outputs.
#[test]
fn test_ark_key_path_changed_output() {
