// A tapscript must leave exactly one element on the stack.
#[test]
fn test_ark_script_path_extra_stack_item() {
    let res = validate_spend(
        "",
        10000,
        "0x51200aabaa2768f0d46559b0f333c3c5eb5cfc716c4e59be2b2fe0dd7da39fd962c5",
    );
    assert_eq!(res.unwrap_err(), Error::SCRIPT_NON_CLEAN_STACK);
}
